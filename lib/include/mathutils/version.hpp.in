#ifndef MATHUTILS_VERSION_HPP
#define MATHUTILS_VERSION_HPP

/// \file version.hpp
/// \brief Compile-time version information for the mathutils library.
///
/// This header is generated by CMake from `version.hpp.in`; the macro values
/// are substituted from the `project()` version in the top-level CMakeLists.

#define MATHUTILS_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define MATHUTILS_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define MATHUTILS_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define MATHUTILS_VERSION_STRING "@PROJECT_VERSION@"

namespace mathutils {

/// Semantic version of the library, e.g. "1.0.0".
inline constexpr const char* version() noexcept {
    return MATHUTILS_VERSION_STRING;
}

}  // namespace mathutils

#endif  // MATHUTILS_VERSION_HPP
